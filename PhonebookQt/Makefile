####### Compile

build/obj/main.o: main.cpp src/views/MainWindow.h \
		src/models/ContactManager.h \
		src/models/Contact.h \
		src/storage/IStorage.h \
		src/storage/JSONStorage.h \
		src/storage/PostgresStorage.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/obj/main.o main.cpp

build/obj/Contact.o: src/models/Contact.cpp src/models/Contact.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/obj/Contact.o src/models/Contact.cpp

build/obj/ContactManager.o: src/models/ContactManager.cpp src/models/ContactManager.h \
		src/models/Contact.h \
		src/storage/IStorage.h \
		src/storage/JSONStorage.h \
		src/storage/PostgresStorage.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/obj/ContactManager.o src/models/ContactManager.cpp

build/obj/JSONStorage.o: src/storage/JSONStorage.cpp src/storage/JSONStorage.h \
		src/storage/IStorage.h \
		src/models/Contact.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/obj/JSONStorage.o src/storage/JSONStorage.cpp

build/obj/PostgresStorage.o: src/storage/PostgresStorage.cpp src/storage/PostgresStorage.h \
		src/storage/IStorage.h \
		src/models/Contact.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/obj/PostgresStorage.o src/storage/PostgresStorage.cpp

build/obj/MainWindow.o: src/views/MainWindow.cpp src/views/MainWindow.h \
		src/models/ContactManager.h \
		src/models/Contact.h \
		src/storage/IStorage.h \
		src/storage/JSONStorage.h \
		src/storage/PostgresStorage.h \
		build/ui/ui_MainWindow.h \
		src/views/ContactDialog.h \
		src/views/PostgresConfigDialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/obj/MainWindow.o src/views/MainWindow.cpp

build/obj/ContactDialog.o: src/views/ContactDialog.cpp src/views/ContactDialog.h \
		src/models/Contact.h \
		build/ui/ui_ContactDialog.h \
		src/utils/Validator.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/obj/ContactDialog.o src/views/ContactDialog.cpp

build/obj/PostgresConfigDialog.o: src/views/PostgresConfigDialog.cpp src/views/PostgresConfigDialog.h \
		build/ui/ui_PostgresConfigDialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/obj/PostgresConfigDialog.o src/views/PostgresConfigDialog.cpp

build/obj/Validator.o: src/utils/Validator.cpp src/utils/Validator.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/obj/Validator.o src/utils/Validator.cpp

build/obj/moc_MainWindow.o: build/moc/moc_MainWindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/obj/moc_MainWindow.o build/moc/moc_MainWindow.cpp

build/obj/moc_ContactDialog.o: build/moc/moc_ContactDialog.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/obj/moc_ContactDialog.o build/moc/moc_ContactDialog.cpp

build/obj/moc_PostgresConfigDialog.o: build/moc/moc_PostgresConfigDialog.cpp 
